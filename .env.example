# InterviewIQ environment configuration
# Copy this file to .env and add your own API key. Never commit .env to GitHub.

# AI provider: auto | anthropic | openai | none
LLM_PROVIDER=openai

# Option A — Gemini (OpenAI-compatible endpoint)
# Create a key in Google AI Studio, then uncomment/fill these values.
OPENAI_API_KEY=
OPENAI_MODEL=gemini-2.5-flash
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Option B — OpenAI (replace the values above if using OpenAI)
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Option C — Groq (OpenAI-compatible; use a model currently available in your Groq account)
# OPENAI_MODEL=llama-3.3-70b-versatile
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Option D — Anthropic (instead of OpenAI-compatible provider)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# App security / data
MENTOR_ACCESS_CODE=change-this-to-a-long-random-code
DATABASE_PATH=data/interviewiq.db
